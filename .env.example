# Clave de la Maps JavaScript API de Google.
# Sin esta variable la sección de ubicación cae al mapa satelital estático.
# Restringirla por dominio (HTTP referrers) en Google Cloud antes de usarla en producción.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Umami self-hosted (analytics.lariberavgg.com). No son secretos: el script y
# el id viajan al navegador de todos modos. El script sólo se carga en
# producción, así que en `next dev` estas variables no hacen nada.
NEXT_PUBLIC_UMAMI_SRC=https://analytics.lariberavgg.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=73f8b815-e4a5-41e7-8714-b0c783189fd2
